<div data-recording-studio-mcp-docs="<%= @page.api_key %>">
  <% content_for :title, @page.title %>
  <redoc id="mcp-docs-redoc" disable-telemetry="true"></redoc>
  <script type="module">
    import { init } from <%= raw mcp_docs_redoc_path.to_json %>;
    init(<%= raw mcp_docs_spec_path.to_json %>, { disableTelemetry: true }, document.getElementById("mcp-docs-redoc"));
  </script>
</div>
