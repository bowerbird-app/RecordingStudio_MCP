#!/usr/bin/env bash
# Export the dummy app's live public MCP OpenAPI document.
# That file is the example dummy app spec. It is not a host catalog snapshot.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DUMMY_DIR="${ROOT}/test/dummy"
OUTPUT="${ROOT}/docs/example-app.openapi.json"

dummy_bundle() {
  (
    cd "${DUMMY_DIR}"
    BUNDLE_GEMFILE="${DUMMY_DIR}/Gemfile" bundle exec "$@"
  )
}

dummy_bundle rails runner - "${OUTPUT}" <<'RUBY'
require "json"

path = ARGV.fetch(0)
spec = RecordingStudioMcp::Documentation.openapi(api: :public)
spec = spec.deep_stringify_keys
spec["info"] ||= {}
spec["info"]["title"] = "Example dummy app MCP"
instructions = spec["info"]["description"].to_s
spec["info"]["description"] =
  "Example dummy app. Generated from the dummy catalog, not a host snapshot. #{instructions}".strip
spec["x-mcp"] ||= {}
spec["x-mcp"]["instructions"] = spec["info"]["description"]

File.write(path, "#{JSON.pretty_generate(spec)}\n")
RUBY

echo "Example dummy app OpenAPI written to ${OUTPUT}"
