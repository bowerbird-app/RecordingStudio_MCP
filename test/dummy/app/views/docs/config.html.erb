<% dummy_page_nav(title: "Config", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Config",
    subtitle: "MCP advertises its own protected-resource metadata. Oauth stays the authorization server.",
    variant: :h1
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      RecordingStudioMcp.configure do |config|
        config.mcp_mount_path = "/recording_studio_mcp"
        config.oauth_protected_resource_path = "/.well-known/oauth-protected-resource/recording_studio_mcp"
        config.oauth_engine_mount_path = "/recording_studio_oauth"
      end
    CODE
  ) %>
</div>
