<% dummy_page_nav(title: "Test token", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Test token",
    subtitle: "Dummy-only. Grab one, copy it once, paste it into your MCP client.",
    variant: :h1
  ) %>

  <p class="text-sm leading-6">
    <code>/recording_studio_mcp</code>
  </p>
  <p class="text-sm leading-6">
    After Connect, call <code>initialize</code> then <code>tools/list</code>. Use <code>describe</code> before create.
  </p>
  <p class="text-sm leading-6">
    The Connect token works here and with the API on purpose.
  </p>

  <% if mcp_test_token_minting_allowed? %>
    <% if @mcp_test_token.present? %>
      <%= render FlatPack::Alert::Component.new(
        title: "Copy it now",
        description: "This is the only time you’ll see it.",
        style: :success
      ) %>
      <%= render FlatPack::TextInput::Component.new(
        name: "test_token",
        label: "Test token",
        value: @mcp_test_token,
        quick_copy: true
      ) %>
    <% else %>
      <%= form_with url: docs_mcp_test_token_path, method: :post, local: true, data: { turbo: false } do %>
        <%= render FlatPack::Button::Component.new(
          text: "Get a test token",
          style: :primary,
          size: :md,
          type: "submit"
        ) %>
      <% end %>
    <% end %>
  <% end %>
</div>
