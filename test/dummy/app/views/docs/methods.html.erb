<% dummy_page_nav(title: "Tools", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Tools",
    subtitle: "Parameterized tools over the named API the OauthClient is bound to.",
    variant: :h1
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "tools/call",
    subtitle: "list, show, create, update, capability_action, describe"
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :json,
    code: <<~'CODE'
      {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "tools/call",
        "params": {
          "name": "list",
          "arguments": { "type": "Workspace" }
        }
      }
    CODE
  ) %>
</div>
