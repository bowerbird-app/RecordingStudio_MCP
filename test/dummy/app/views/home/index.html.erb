<% dummy_page_nav(title: "MCP dummy", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "MCP dummy",
    subtitle: "This host proves the MCP endpoint. It is not the product.",
    variant: :h1
  ) %>

  <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
    <% card.header do %>
      <%= render FlatPack::PageTitle::Component.new(
        title: "MCP URL",
        subtitle: "Point a remote MCP client here after Connect.",
        variant: :h3,
        class: "mb-0 pb-0"
      ) %>
    <% end %>
    <% card.body do %>
      <p class="text-sm leading-6">
        <code>/recording_studio_mcp</code>
      </p>
      <p class="text-sm leading-6">
        Sign in, Connect Seed MCP App, then call tools. The same token works with MCP and the API on purpose.
      </p>
    <% end %>
  <% end %>

  <%= render FlatPack::PageTitle::Component.new(
    title: "Tweak this page",
    subtitle: "Save a change so a watching assistant is told to read it again.",
    variant: :h2
  ) %>

  <% if @page_recording %>
    <p class="text-sm leading-6">
      Now: <%= @page_title %>
    </p>
    <%= form_with url: save_page_change_path, method: :post, local: true, data: { turbo: false } do %>
      <%= render FlatPack::Button::Component.new(
        text: "Edit recording",
        style: :primary,
        size: :md,
        type: "submit"
      ) %>
    <% end %>
  <% else %>
    <p class="text-sm leading-6">
      No page yet. Run seeds, then come back.
    </p>
  <% end %>
</div>
