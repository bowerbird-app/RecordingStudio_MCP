<% dummy_page_nav(title: "MCP dummy", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "MCP dummy",
    subtitle: "This host proves the MCP endpoint. It is not the product.",
    variant: :h1
  ) %>

  <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
    <% card.header do %>
      <%= render FlatPack::PageTitle::Component.new(
        title: "MCP URL",
        subtitle: "Point a remote MCP client here after Connect.",
        variant: :h3,
        class: "mb-0 pb-0"
      ) %>
    <% end %>
    <% card.body do %>
      <p class="text-sm leading-6">
        <code>/recording_studio_mcp</code>
      </p>
      <p class="text-sm leading-6">
        Sign in, Connect Seed MCP App, then call tools with the API Bearer token.
      </p>
    <% end %>
  <% end %>
</div>
